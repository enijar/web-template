{
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "NODE_ENV=development conc -n client,server,emails \"npm run start:client\" \"npm run start:server\" \"npm run start:emails\"",
    "build": "NODE_ENV=production npm run build:client && npm run build:server",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "start:emails": "email dev -d src/emails -p 9999",
    "start:client": "vite",
    "start:server": "tsx --watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "rm -rf build/config build/server && tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "env:encrypt:dev": "dotenvx encrypt -f .env.dev",
    "env:encrypt:prod": "dotenvx encrypt -f .env.prod",
    "env:decrypt:dev": "dotenvx decrypt -f .env.dev",
    "env:decrypt:prod": "dotenvx decrypt -f .env.prod"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@hono/node-server": "2.1.1",
    "@hono/trpc-server": "0.4.2",
    "@sendgrid/mail": "8.1.6",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/mysql": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "argon2": "0.45.1",
    "hono": "4.13.2",
    "jose": "6.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "styled-components": "6.5.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-styled-components": "2.3.0",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react-email": "6.9.2",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true
  }
}
